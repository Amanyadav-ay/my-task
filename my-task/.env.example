# ==========================================
# MY TASK - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Local or Cloud like Neon, Supabase, Render)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mytask_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="your_secure_access_secret_here"
JWT_REFRESH_SECRET="your_secure_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Web Push Notification VAPID Keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@mytask.local"

# Nodemailer SMTP Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="My Task <notifications@mytask.local>"

# AI Productivity Assistant (Optional: 'gemini', 'openai', or 'heuristic')
AI_PROVIDER=heuristic
AI_API_KEY=""
